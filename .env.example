PORT=3000

# MongoDB connection (Atlas or local, e.g. mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=<AppName>
MONGODB_DB_NAME=RealtimeChat

# The chat client served by this server is always allowed. Add other browser
# origins here (comma-separated) only if you host the client somewhere else.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=10m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Optional
# Behind a reverse proxy / PaaS (Render, Railway, nginx): number of proxy hops,
# so per-IP rate limits see the real client address
# TRUST_PROXY=1
# Login/register attempts per IP per 15 minutes (default 30)
# AUTH_RATE_LIMIT_MAX=30
