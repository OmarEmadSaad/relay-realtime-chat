{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "Real-time chat app with Socket.IO, Express 5, MongoDB and JWT auth, written in TypeScript",
  "main": "src/server.ts",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p client",
    "start": "node src/server.ts",
    "dev": "tsc -p client && node --watch src/server.ts",
    "dev:client": "tsc -p client --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json && tsc -p client --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "seed": "node scripts/seedDemo.ts",
    "create-manager": "node scripts/createManager.ts"
  },
  "keywords": [
    "socket.io",
    "express",
    "mongodb",
    "jwt",
    "chat",
    "real-time",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/validator": "^13.15.10",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
